class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {
        vector<int>vec;
        int n=nums.size();
        for(int i=0;i<n;i++){
            bool found = false;
            for(int j=i+1;j<n;j++){
                if(nums[i]+nums[j]==target){
                    vec.push_back(i);
                    vec.push_back(j);
                    found=true;
                }
                if(found)
                    break;
            }
        }
        return vec;
    }
};
