int longestSubarray(vector<int>& arr, int k) {
        // code here
        int ans=0;
        int n=arr.size();
        for(int i=0;i<n;i++){
            int s=0;
            for(int j=i; j<n;j++){
                s+=arr[j];
                if(s==k){
                    ans=max(ans,j-i+1);
                }
            }
        }
        return ans;
    }
